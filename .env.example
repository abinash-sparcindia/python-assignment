# Example settings only. Replace every value outside version control.
# The Compose review stack generates SIGNING_SECRET and the database password.
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://utility_assets:change-me@db:5432/utility_assets
SIGNING_SECRET=replace-with-a-random-string-of-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
TOKEN_LIFETIME_MINUTES=60
REQUESTS_PER_MINUTE=60
